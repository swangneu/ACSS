{
  "topology": "flyback",
  "applies_to_families": ["dc_dc_isolated"],
  "description": "Flyback converter. Watch subharmonic oscillation, leakage spike, CCM/DCM transition, and duty saturation.",
  "key_signals": ["vout_v", "iL_primary_a"],
  "metrics": [
    {"id": "tail_pp_to_mean_ratio", "extractor": "ratio", "args": {"numerator": "tail_pp_v", "denominator": "tail_abs_mean_v"}},
    {"id": "first_peak_to_tail_ratio", "extractor": "first_peak_to_tail_ratio"},
    {"id": "dominant_osc_hz", "extractor": "dominant_osc_hz", "args": {"signal": "vout_v"}},
    {"id": "zero_crossings_in_tail", "extractor": "zero_crossings_in_tail"}
  ],
  "pathologies": [
    {
      "id": "subharmonic_oscillation",
      "when": {"all": [
        {"metric": "dominant_osc_hz", "op": ">", "value": 0},
        {"metric": "dominant_osc_hz", "op": "<", "value": "fsw_hz * 0.6"},
        {"metric": "tail_pp_to_mean_ratio", "op": ">", "value": 0.05}
      ]},
      "implies": "architecture_or_tuning",
      "explanation": "Oscillation below fsw — subharmonic instability from peak-current-mode without slope compensation. Add ramp >= inductor downslope/2."
    },
    {
      "id": "leakage_spike",
      "when": {"all": [
        {"metric": "first_peak_to_tail_ratio", "op": ">", "value": 2.0},
        {"metric": "zero_crossings_in_tail", "op": "<=", "value": 1}
      ]},
      "implies": "implementation",
      "explanation": "Large initial spike with no ringing — likely leakage inductance energy causing voltage spike at turn-off. Add or verify RCD clamp/snubber."
    },
    {
      "id": "duty_saturation",
      "when": {"all": [
        {"metric": "tail_abs_mean_v", "op": "<", "value": "abs_target * 0.8"},
        {"metric": "steady_state_abs_error_pct", "op": ">", "value": 10}
      ]},
      "implies": "architecture",
      "explanation": "Output cannot reach target — duty-cycle saturation or turns ratio mismatch."
    },
    {
      "id": "no_response",
      "when": {"metric": "tail_abs_mean_v", "op": "<", "value": "abs_target * 0.1"},
      "implies": "implementation",
      "explanation": "Output never approaches target — sign/scale/wiring error or transformer phasing reversed."
    }
  ]
}
