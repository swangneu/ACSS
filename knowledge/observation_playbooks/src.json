{
  "topology": "src",
  "applies_to_families": ["dc_dc_resonant"],
  "description": "Series resonant converter. Watch gain <= 1 limitation, light-load regulation, and frequency hunting.",
  "key_signals": ["vout_v", "i_tank_a", "f_cmd_hz"],
  "metrics": [
    {"id": "tail_pp_to_mean_ratio", "extractor": "ratio", "args": {"numerator": "tail_pp_v", "denominator": "tail_abs_mean_v"}},
    {"id": "first_peak_to_tail_ratio", "extractor": "first_peak_to_tail_ratio"},
    {"id": "dominant_osc_hz", "extractor": "dominant_osc_hz", "args": {"signal": "vout_v"}},
    {"id": "zero_crossings_in_tail", "extractor": "zero_crossings_in_tail"}
  ],
  "pathologies": [
    {
      "id": "frequency_hunting",
      "when": {"all": [
        {"metric": "zero_crossings_in_tail", "op": ">=", "value": 4},
        {"metric": "tail_pp_to_mean_ratio", "op": ">", "value": 0.05}
      ]},
      "implies": "tuning",
      "explanation": "Output oscillates — controller hunting on the flat gain curve at light load. SRC has very poor light-load regulation."
    },
    {
      "id": "gain_limit",
      "when": {"all": [
        {"metric": "tail_abs_mean_v", "op": "<", "value": "abs_target * 0.8"},
        {"metric": "steady_state_abs_error_pct", "op": ">", "value": 10}
      ]},
      "implies": "architecture",
      "explanation": "Output cannot reach target — SRC gain is limited to <= 1. Verify the turns ratio is sufficient for the required step-up."
    },
    {
      "id": "no_response",
      "when": {"metric": "tail_abs_mean_v", "op": "<", "value": "abs_target * 0.1"},
      "implies": "implementation",
      "explanation": "Output dead — check gate drive, tank connection, and frequency command."
    }
  ]
}
