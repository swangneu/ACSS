{
  "topology": "sepic",
  "applies_to_families": ["dc_dc_nonisolated"],
  "description": "SEPIC converter. Watch RHPZ dynamics, coupling capacitor stress, and CCM/DCM transition.",
  "key_signals": ["vout_v", "iL1_a", "iL2_a"],
  "metrics": [
    {"id": "tail_pp_to_mean_ratio", "extractor": "ratio", "args": {"numerator": "tail_pp_v", "denominator": "tail_abs_mean_v"}},
    {"id": "first_peak_to_tail_ratio", "extractor": "first_peak_to_tail_ratio"},
    {"id": "dominant_osc_hz", "extractor": "dominant_osc_hz", "args": {"signal": "vout_v"}},
    {"id": "zero_crossings_in_tail", "extractor": "zero_crossings_in_tail"}
  ],
  "pathologies": [
    {
      "id": "rhpz_undershoot",
      "when": {"all": [
        {"metric": "first_peak_to_tail_ratio", "op": ">", "value": 1.3},
        {"metric": "zero_crossings_in_tail", "op": ">=", "value": 1}
      ]},
      "implies": "tuning_or_architecture",
      "explanation": "Initial dip before overshoot — RHPZ-limited SEPIC in CCM. Voltage-loop bandwidth exceeds RHPZ frequency."
    },
    {
      "id": "no_response",
      "when": {"metric": "tail_abs_mean_v", "op": "<", "value": "abs_target * 0.1"},
      "implies": "implementation",
      "explanation": "Output never approaches target — sign/scale/wiring error or coupling capacitor not charging."
    },
    {
      "id": "limit_cycle",
      "when": {"all": [
        {"metric": "tail_pp_to_mean_ratio", "op": ">", "value": 0.2},
        {"metric": "zero_crossings_in_tail", "op": ">=", "value": 6}
      ]},
      "implies": "tuning_or_architecture",
      "explanation": "Sustained oscillation — saturation or integrator windup, possibly from duty-cycle saturation at extreme D."
    }
  ]
}
